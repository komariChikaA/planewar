@startuml
title HeroAircraft Singleton Pattern

left to right direction
skinparam backgroundColor #FAFAF7
skinparam shadowing false
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

skinparam package {
    BackgroundColor #FFFDF5
    BorderColor #C9B98F
}

skinparam class {
    BackgroundColor #FFF8E7
    BorderColor #7A6A43
    ArrowColor #5D6B75
    FontColor #2F2A22
}

package "application" {
    class Game <<Client>>
}

package "aircraft" {
    class HeroAircraft <<Singleton>> {
        - {static} instance: HeroAircraft
        - HeroAircraft(locationX, locationY, speedX, speedY, hp)
        + {static} getInstance(locationX, locationY, speedX, speedY, hp): HeroAircraft
        + {static} resetInstance(): void
        + shoot()
    }
}

Game ..> HeroAircraft : getInstance()



@enduml
